@model IEnumerable<BE_NguyenThanhDat.Models.Product>

@{
    ViewBag.Title = "Index";
    int current = ViewBag.Page;
    int totalItems = ViewBag.TotalItems;
    int pageSize = ViewBag.PageSize;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
}

<h2>Products</h2>

@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm sản phẩm..." />
    <button type="submit">Search</button>
}

<p>@Html.ActionLink("Create New", "Create")</p>

<table class="table">
    <tr>
        <th>
            @Html.ActionLink(
                "Category",
                "Index",
                new { search = ViewBag.Search, sort = ViewBag.Sort == "cat_asc" ? "cat_desc" : "cat_asc", page = current })
        </th>

        <th>
            @Html.ActionLink(
                "Name",
                "Index",
                new { search = ViewBag.Search, sort = ViewBag.Sort == "name_asc" ? "name_desc" : "name_asc", page = current })
        </th>

        <th>Description</th>

        <th>
            @Html.ActionLink(
                "Price",
                "Index",
                new { search = ViewBag.Search, sort = ViewBag.Sort == "price_asc" ? "price_desc" : "price_asc", page = current })
        </th>

        <th>Image</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Category.CategoryName</td>
            <td>@item.ProductName</td>
            <td>@item.ProductDecription</td>
            <td>@item.ProductPrice</td>
            <td>@item.ProductImage</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.ProductID }) |
                @Html.ActionLink("Details", "Details", new { id = item.ProductID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.ProductID })
            </td>
        </tr>
    }
</table>

<div>
    @if (current > 1)
    {
        @Html.ActionLink("Prev", "Index", new { page = current - 1, search = ViewBag.Search, sort = ViewBag.Sort })
    }

    <span> Page @current / @totalPages </span>

    @if (current < totalPages)
    {
        @Html.ActionLink("Next", "Index", new { page = current + 1, search = ViewBag.Search, sort = ViewBag.Sort })
    }
</div>
